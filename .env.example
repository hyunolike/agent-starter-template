# demo is deterministic and never calls a paid model.
AGENT_MODEL_PROVIDER=demo
# Required only when AGENT_MODEL_PROVIDER=anthropic.
AGENT_MODEL_NAME=claude-sonnet-4-6
ANTHROPIC_API_KEY=
# Optional shared bearer token for this single-tenant starter.
AGENT_API_TOKEN=
AGENT_DATABASE_PATH=var/checkpoints.sqlite
AGENT_MAX_MODEL_CALLS=5
AGENT_MAX_TOOL_CALLS=8
AGENT_RUN_TIMEOUT_SECONDS=60
AGENT_TOOL_TIMEOUT_SECONDS=10
AGENT_MAX_HISTORY_MESSAGES=200
